{
  "name": "ZombieSurvivalLobby",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "lobby/src/shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "lobby/src/server"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "lobby/src/client"
        }
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "FilteringEnabled": true,
        "Gravity": 196.2
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Ambient": [60, 60, 65],
        "OutdoorAmbient": [70, 70, 75],
        "Brightness": 1.8,
        "ClockTime": 14,
        "FogColor": [140, 135, 140],
        "FogStart": 200,
        "FogEnd": 900,
        "GlobalShadows": true,
        "GeographicLatitude": 41.7
      }
    }
  }
}
