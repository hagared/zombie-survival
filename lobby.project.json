{
  "name": "ZombieSurvivalLobby",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "lobby/src/shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "lobby/src/server"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "lobby/src/client"
        }
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "FilteringEnabled": true,
        "Gravity": 196.2
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Ambient": [80, 80, 80],
        "OutdoorAmbient": [130, 130, 135],
        "Brightness": 2,
        "ClockTime": 14,
        "FogColor": [160, 155, 150],
        "FogStart": 350,
        "FogEnd": 1400
      }
    }
  }
}
